# Copy this file to backend/.env and replace placeholders with local values.
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/third-eye
JWT_SECRET=replace-with-a-long-random-secret

# Optional: required for AI assistant, AI grading, and question parsing.
GEMINI_API_KEY=replace-with-your-google-ai-api-key

# Optional: required for email-based password reset.
EMAIL_USER=your-email@example.com
EMAIL_PASS=replace-with-your-email-app-password
